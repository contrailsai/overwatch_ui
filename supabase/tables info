create table public.project (
  created_at timestamp with time zone not null default now(),
  project_name text not null,
  mongo_db_map text null,
  project_details json null,
  editable boolean not null default false,
  constraint Project_pkey primary key (project_name)
) TABLESPACE pg_default;

create table public.client_details (
  id uuid not null default auth.uid (),
  created_at timestamp with time zone not null default now(),
  permission character varying not null default 'client'::character varying,
  email character varying not null,
  notification_config jsonb null,
  project_name text null,
  meta_stats jsonb null,
  organization text null default ''::text,
  alias text null,
  constraint client - details_pkey primary key (id),
  constraint client - details_id_fkey foreign KEY (id) references auth.users (id),
  constraint client_details_project_name_fkey foreign KEY (project_name) references project (project_name)
) TABLESPACE pg_default;

create table public.client_logs (
  id bigint generated by default as identity not null,
  created_at timestamp with time zone not null default now(),
  date date null,
  login_time time with time zone null,
  last_activity time with time zone null,
  reviewed_cases integer null,
  reviewed_profiles integer null,
  project_name text null,
  client_id uuid null,
  reports_download jsonb null default '{}'::jsonb,
  constraint client - logs_pkey primary key (id),
  constraint client_logs_unique_day unique (client_id, project_name, date),
  constraint client - logs_project_name_fkey foreign KEY (project_name) references project (project_name),
  constraint client_logs_client_id_fkey foreign KEY (client_id) references auth.users (id) on delete CASCADE
) TABLESPACE pg_default;

create table public.client_requested_links (
  id bigint generated by default as identity not null,
  created_at timestamp with time zone not null default now(),
  requested_by uuid null,
  link text null,
  ingested text not null default 'pending'::text,
  project text null,
  case_id text null,
  constraint client_requested_links_pkey primary key (id),
  constraint client_requested_links_project_fkey foreign KEY (project) references project (project_name),
  constraint client_requested_links_requested_by_fkey foreign KEY (requested_by) references auth.users (id),
  constraint check_ingested_status check (
    (
      ingested = any (
        array[
          'pending'::text,
          'ingested'::text,
          'failed'::text,
          'enlisted'::text
        ]
      )
    )
  )
) TABLESPACE pg_default;

create table public.daily_case_metrics (
  id bigint generated by default as identity not null,
  created_at timestamp with time zone not null default now(),
  project_name text null,
  platform text null,
  date date null,
  risk json null,
  categories json null,
  total_cases integer null,
  constraint daily_case_metrics_pkey primary key (id),
  constraint daily_case_metrics_day_platform_project_unique unique (date, platform, project_name),
  constraint daily_case_metrics_project_name_fkey foreign KEY (project_name) references project (project_name)
) TABLESPACE pg_default;

create table public.daily_reviewed_metrics (
  id bigint generated by default as identity not null,
  created_at timestamp with time zone not null default now(),
  project_name text null,
  date date null,
  platform text null,
  reviewed json null,
  risk json null,
  total_reviewed integer null,
  constraint daily_reviewed_metrics_pkey primary key (id),
  constraint daily_reviewed_metrics_day_platform_project_unique unique (date, platform, project_name),
  constraint daily_reviewed_metrics_project_name_fkey foreign KEY (project_name) references project (project_name)
) TABLESPACE pg_default;

create table public.notifications (
  id bigint generated by default as identity not null,
  created_at timestamp with time zone not null default now(),
  client_email character varying not null,
  notification_msg character varying null default ''::character varying,
  notification_action json null,
  has_read boolean null default false,
  constraint Notifications_pkey primary key (id)
) TABLESPACE pg_default;

create table public.reports_generation (
  id bigint generated by default as identity not null,
  last_update timestamp with time zone not null default now(),
  report_hash text null,
  finish_time timestamp with time zone null,
  project text null,
  s3_path text null,
  status text null,
  report_type text null,
  constraint reports_generation_pkey primary key (id),
  constraint reports_generation_project_fkey foreign KEY (project) references project (project_name)
) TABLESPACE pg_default;

create table public.watchlist (
  id bigint generated by default as identity not null,
  created_at timestamp with time zone not null default now(),
  link character varying null,
  type character varying null default 'profile'::character varying,
  project_name text null,
  last_checked timestamp with time zone null,
  constraint watchlist_pkey primary key (id),
  constraint watchlist_project_name_fkey foreign KEY (project_name) references project (project_name)
) TABLESPACE pg_default;